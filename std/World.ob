var: #Nil    is: () prototype.
var: #Symbol is: #'' prototype.
var: #String is: '' prototype.
var: #Slots  is: Nil prototype.
var: #Number is: 0 prototype.
var: #Array  is: [] prototype.
var: #Method is: {} prototype.
var: #Object is: Slots prototype.

var: #nil is: ().
Nil at: #nil? put: true.

Method at: #value put: { self call: [] }.
Method at: #call put: (Method at: #value).

(Slots at: #at:put:) callIn: Object with: [
  #Override_:With_: . (Slots at: #at:put:)
].

Object Override_: #value With_: { self }.
Object Override_: #nil? With_: false.

true at: #print put: { 'true' print }.

true at: #then: put: {|t f| t value }.
true at: #else: put: { self }.

true at: #then:else: put: {|t f| t value }.

false at: #print put: { 'false' print }.

false at: #then: put: { self }.
false at: #else: put: {|t f| f value }.

false at: #then:else: put: {|t f| f value }.
