{
    "version": 10,

    "configurePresets": [
        {
            "name": "config.debug",
            "binaryDir": ".build",
            "cacheVariables": {
              "QL_BUILD_TESTS": false,
              "QL_BUILD_DOCS": false
            }
        }
    ],

    "buildPresets": [
        {
            "name": "build.debug",
            "configurePreset": "config.debug",
            "targets": "all"
        }
    ],

    "testPresets": [
        {
            "name": "test.debug",
            "configurePreset": "config.debug"
        }
    ],

    "workflowPresets": [
        {
            "name": "debug",
            "steps": [
                {
                    "type": "configure",
                    "name": "config.debug"
                },
                {
                    "type": "build",
                    "name": "build.debug"
                }
            ]
        },
        {
            "name": "debug-and-test",
            "steps": [
            {
                    "type": "configure",
                    "name": "config.debug"
                },
                {
                    "type": "build",
                    "name": "build.debug"
                },
                {
                    "type": "test",
                    "name": "test.debug"
                }
            ]
        }
    ]
}
