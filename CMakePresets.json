{
    "version": 10,

    "configurePresets": [
        {
            "name": "config.default",
            "hidden": true,

            "binaryDir": ".build",
            "cacheVariables": {
              "QL_BUILD_TESTS": false,
              "QL_BUILD_DOCS": false,
              "CMAKE_BUILD_TYPE": "Debug",
              "CMAKE_EXPORT_COMPILE_COMMANDS": true
            }
        },

        {
            "name": "config.release",
            "inherits": "config.default",
            "cacheVariables": {
                "QL_ENABLE_ASSERTS": false,
                "QL_ENABLE_LOG": false,
                "CMAKE_BUILD_TYPE": "Release"
            }
        },

        {
            "name": "config.debug",
            "inherits": "config.default"
        }
    ],

    "buildPresets": [
        {
            "name": "build.debug",
            "configurePreset": "config.debug",
            "targets": "all"
        },

        {
            "name": "build.release",
            "configurePreset": "config.release",
            "targets": "all"
        },

        {
            "name": "documentation",
            "configurePreset": "config.debug",
            "targets": "docs"
        }
    ],

    "testPresets": [
        {
            "name": "test.debug",
            "configurePreset": "config.debug"
        }
    ],

    "workflowPresets": [
        {
            "name": "debug",
            "steps": [
                {
                    "type": "configure",
                    "name": "config.debug"
                },
                {
                    "type": "build",
                    "name": "build.debug"
                }
            ]
        },

        {
            "name": "release",
            "steps": [
                {
                    "type": "configure",
                    "name": "config.release"
                },
                {
                    "type": "build",
                    "name": "build.release"
                }
            ]
        },

        {
            "name": "debug-and-test",
            "steps": [
            {
                    "type": "configure",
                    "name": "config.debug"
                },
                {
                    "type": "build",
                    "name": "build.debug"
                },
                {
                    "type": "test",
                    "name": "test.debug"
                }
            ]
        }
    ]
}
