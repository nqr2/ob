PROJECT_NAME = "@PROJECT_NAME@"
PROJECT_VERSION = "@VERSION@"
OUTPUT_DIRECTORY = "@OUTPUT_DIR@"

INPUT += "@SOURCE_DIR@/bin/"
INPUT += "@SOURCE_DIR@/core/"
INPUT += "@SOURCE_DIR@/tap/"
INPUT += "@SOURCE_DIR@/tools/"
RECURSIVE = YES

TAB_SIZE = 4

OPTIMIZE_OUTPUT_FOR_C = YES

INLINE_SOURCES = YES
SOURCE_BROWSER = YES
STRIP_CODE_COMMENTS = YES
SEARCHENGINE = YES
#GENERATE_TREEVIEW = YES

GENERATE_LATEX = NO
