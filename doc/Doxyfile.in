PROJECT_NAME = "@PROJECT_NAME@"
PROJECT_NUMBER = "@PROJECT_VERSION@"
OUTPUT_DIRECTORY = "@OUTPUT_DIR@"
INPUT += "@SOURCE_DIR@/core/"
INPUT += "@SOURCE_DIR@/lib/"
INPUT += "@SOURCE_DIR@/std/"
INPUT += "@SOURCE_DIR@/base/"
INPUT += "@SOURCE_DIR@/tests/lib/"
RECURSIVE = YES
TAB_SIZE = 4
OPTIMIZE_OUTPUT_FOR_C = YES
EXTRACT_STATIC=NO
EXTRACT_ALL = YES
SOURCE_BROWSER = YES
STRIP_CODE_COMMENTS = YES
SEARCHENGINE = YES
GENERATE_TREEVIEW = YES
GENERATE_LATEX = NO
TYPEDEF_HIDES_STRUCT = YES
INLINE_SOURCES = YES
DISABLE_INDEX = NO
FULL_SIDEBAR = NO
HAVE_DOT=NO
MACRO_EXPANSION=YES
INLINE_SIMPLE_STRUCTS=YES
HTML_COLORSTYLE = LIGHT
HTML_EXTRA_STYLESHEET += "@SOURCE_DIR@/doc/theme/doxygen-awesome.css"
HTML_EXTRA_STYLESHEET += "@SOURCE_DIR@/doc/theme/doxygen-awesome-sidebar-only.css"
