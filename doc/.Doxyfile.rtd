# This is the configuration used for Read the Docs

PROJECT_NAME = "ob"
PROJECT_NUMBER = "0.0.0"
OUTPUT_DIRECTORY = ".build"
INPUT += "bin/"
INPUT += "core/"
INPUT += "lib/"
INPUT += "std/"
EXCLUDE = "*/tests/*"
RECURSIVE = YES
TAB_SIZE = 4
OPTIMIZE_OUTPUT_FOR_C = YES
EXTRACT_STATIC=NO
EXTRACT_ALL = YES
SOURCE_BROWSER = YES
STRIP_CODE_COMMENTS = YES
SEARCHENGINE = YES
GENERATE_TREEVIEW = YES
GENERATE_LATEX = NO
TYPEDEF_HIDES_STRUCT = YES
INLINE_SOURCES = YES
DISABLE_INDEX = NO
FULL_SIDEBAR = NO
HAVE_DOT=NO
MACRO_EXPANSION=YES
INLINE_SIMPLE_STRUCTS=YES
HTML_COLORSTYLE = LIGHT
HTML_EXTRA_STYLESHEET += "doc/theme/doxygen-awesome.css"
HTML_EXTRA_STYLESHEET += "doc/theme/doxygen-awesome-sidebar-only.css"
